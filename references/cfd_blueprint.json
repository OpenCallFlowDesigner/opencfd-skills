{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "3CX CFD Blueprint",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Project name" },
    "extension": { "type": "string", "description": "Default extension for the flow" },
    "version": { "type": "string", "description": "CFD version" },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "enum": ["string", "int", "boolean"] },
          "initial": { "type": "string" }
        },
        "required": ["type"]
      }
    },
    "flows": {
      "type": "object",
      "properties": {
        "main": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        },
        "error_handler": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        },
        "disconnect_handler": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "prompt_playback",
            "menu",
            "transfer",
            "disconnect",
            "conditional",
            "variable_assignment",
            "loop",
            "user_input",
            "web_service",
            "text_analyzer",
            "execute_csharp"
          ]
        },
        "name": { "type": "string" },
        "parameters": { "type": "object" }
      },
      "required": ["type", "name"]
    }
  }
}
