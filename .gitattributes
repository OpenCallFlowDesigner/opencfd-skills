* text=auto eol=lf

# 3CX CFD source files are Windows-origin and CFD Studio expects CRLF.
# Preserve line endings verbatim.
*.cfdproj  -text
*.flow     -text
*.comp     -text
*.dialer   -text
references/3cx-official-demos/** -text

# Golden Studio build outputs are Windows-origin (CRLF). Preserve verbatim so
# they remain a faithful byte-for-byte oracle; the golden test normalizes EOL.
golden/** -text
